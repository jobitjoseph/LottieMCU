/*
  LottieMCU: Eco Green Bulb, an all-vector animation (no images) of a light bulb
  filling with green light while a vine grows around it. Uses TFT_eSPI.

  The animation is generated by extras/eco_green_bulb/make_eco_bulb.py.

  Part of LottieMCU 1.1.0 - https://github.com/jobitjoseph/LottieMCU
  Copyright (c) 2026 Jobit Joseph. MIT License.
*/
#include <TFT_eSPI.h>
#include <LottieMCU.h>
#include "eco_green_bulb.h"

const bool USE_PSRAM = true;  // ESP32: keep LottieMCU's tables in PSRAM if present

TFT_eSPI tft;
LottieMCU lottie;

void flush(int16_t x, int16_t y, uint16_t w, uint16_t h, const uint16_t *pixels, void *) {
  tft.pushImage(x, y, w, h, (uint16_t *)pixels);
}

void setup() {
  Serial.begin(115200);
  tft.init();
  tft.setSwapBytes(true);
  tft.fillScreen(TFT_WHITE);

  LottieMCU::Config cfg;
  cfg.usePSRAM = USE_PSRAM;
  cfg.maxGradients = 24;  // the bulb, base, leaves and vine use 19 gradients
  if (!lottie.begin(eco_green_bulb, tft.width(), tft.height(), cfg)) {
    Serial.printf("LottieMCU begin failed: %d\n", lottie.status());
    while (true) delay(1000);
  }
  lottie.setFlush(flush);
  lottie.setBackground(TFT_WHITE);
}

void loop() {
  tft.startWrite();
  lottie.update(millis());
  tft.endWrite();
}
